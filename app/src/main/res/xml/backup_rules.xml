<?xml version="1.0" encoding="utf-8"?>
<!--
  For Android 11 (API 30) and below. See data_extraction_rules.xml for details:
  Signal only uses key-value backup via its BackupAgent, so exclude everything
  from file-based (Auto) backup.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
